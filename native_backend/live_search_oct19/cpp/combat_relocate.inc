// Raw game_logic.move_army for combat advances/retreats: no die or action tail.
struct crl_Request {std::string from,to;int side=0;int64_t regular=-1,elite=-1,leaders=-1,nazgul=-1;bool battle_context=false,defer_stacking=false;};
bool crl_plain(const Snapshot& s,uint64_t leader){const auto type=object_type(s,leader);if(type=="game_state.Companion"||type=="game_state.Nazgul")return false;const auto name=obs_attr(s,leader,"name",false);return !text_is(s,name,"Saruman")&&!text_is(s,name,"Witch King")&&!text_is(s,name,"Mouth of Sauron");}
void crl_orphans(Snapshot& s){const auto entries=child_edges(s,obs_attr(s,s.root,"armies"));for(size_t i=0;i<entries.size();i+=2){const auto army=entries[i+1];if(truth(s,obs_attr(s,army,"units"))||!truth(s,obs_attr(s,army,"leaders")))continue;std::vector<uint64_t> keep;for(auto leader:child_edges(s,obs_attr(s,army,"leaders")))if(!crl_plain(s,leader))keep.push_back(leader);am_assign_list(s,army,"leaders",keep);if(keep.empty())am_erase(s,text(s,entries[i]));}}
void crl_move(Snapshot& s,const Snapshot& tables,const crl_Request& req,uint64_t context=missing){
    require(req.side==0||req.side==1,"Combat relocation requires an explicit side");for(auto count:{req.regular,req.elite,req.leaders,req.nazgul})require(count>=-1,"Invalid combat relocation count");const auto pc=context==missing?obs_attr(s,s.root,"pending_combat",false):context;require(!req.defer_stacking||(req.battle_context&&!ctx_none(s,pc)&&text_is(s,field(s,pc,"phase"),"victor_advance")),"Deferred stacking requires victory advance");
    const auto from=sanitize_name(req.from),to=sanitize_name(req.to),from_key=am_key(s,from);require(!from_key.empty(),"Combat relocation source missing");const auto board=obs_attr(s,s.root,"board");require(contains_string(s,ctx_get(s,obs_attr(s,board,"_adj"),from),to),"Combat relocation destination not adjacent");const auto src=mu_army(s,from),to_region=ctx_get(s,obs_attr(s,board,"_regions"),to);require(!ctx_none(s,to_region),"Combat relocation destination not on board");auto to_key=am_key(s,to);if(to_key.empty())to_key=std::string(text(s,obs_attr(s,to_region,"orig_name")));auto dst=mu_army(s,to);const auto units=child_edges(s,obs_attr(s,src,"units")),leaders=child_edges(s,obs_attr(s,src,"leaders"));
    auto r=req.regular,e=req.elite,l=req.leaders,n=req.nazgul;const bool no_counts=r<0&&e<0&&l<0&&n<0;std::set<uint64_t> eligible_units,eligible_leaders;
    if(req.battle_context){require(!ctx_none(s,pc),"Combat relocation needs live context");const auto parts=ca_partition(s,src,from,req.side,pc);eligible_units.insert(parts.units.begin(),parts.units.end());eligible_leaders.insert(parts.leaders.begin(),parts.leaders.end());if(no_counts){r=e=0;for(auto u:parts.units)(enum_is(s,obs_attr(s,u,"kind"),"game_state.UnitKind","REGULAR")?r:e)++;l=parts.leaders.size();}}
    if(r<0&&e<0&&l<0&&n<0&&!units.empty()&&std::any_of(units.begin(),units.end(),[&](uint64_t u){return ctx_unit_side(s,u)!=req.side;})){r=e=l=0;for(auto u:units)if(ctx_unit_side(s,u)==req.side)(enum_is(s,obs_attr(s,u,"kind"),"game_state.UnitKind","REGULAR")?r:e)++;for(auto leader:leaders)l+=!am_saruman(s,leader)&&am_leader_side(s,leader)==req.side;}
    int cap=10;size_t own_dst=0;if(dst!=missing){const auto deployed=child_edges(s,obs_attr(s,dst,"units"));for(auto u:deployed)own_dst+=ctx_unit_side(s,u)==req.side;if(!deployed.empty()&&own_dst==deployed.size()&&contains_string(s,obs_attr(s,s.root,"besieged_strongholds",false),to))cap=5;}
    auto cap_check=[&](size_t moving){require(req.defer_stacking||dst==missing||own_dst+moving<=static_cast<size_t>(cap),"Combat relocation exceeds destination stacking cap");};
    std::vector<uint64_t> arriving_leaders;
    if(r<0&&e<0&&l<0&&n<0){
        cap_check(units.size());std::vector<uint64_t> stay,moving;for(auto leader:leaders)if(am_saruman(s,leader))stay.push_back(leader);for(auto leader:leaders)if(am_leader_side(s,leader)!=req.side&&!am_saruman(s,leader))stay.push_back(leader);for(auto leader:leaders)if(std::none_of(stay.begin(),stay.end(),[&](uint64_t other){return tail_equal(s,leader,other);}))moving.push_back(leader);if(!stay.empty())am_assign_list(s,src,"leaders",moving);const auto old_region=obs_attr(s,src,"region");am_erase(s,from_key);if(dst==missing){dst=src;am_insert(s,to_key,src);}rr_set_attr(s,src,"region",to_region);if(dst!=src){am_extend(s,dst,"units",units);am_extend(s,dst,"leaders",moving);}if(!stay.empty()){const auto back=am_new_army(s,old_region);am_insert(s,from_key,back);am_extend(s,back,"leaders",stay);}
        arriving_leaders=moving;
    }else{
        std::vector<uint64_t> moved_elite,moved_regular,kept_elite,kept_regular,others,moving,kept;for(auto u:units){if(ctx_unit_side(s,u)!=req.side||(req.battle_context&&!eligible_units.count(u))){others.push_back(u);continue;}const bool elite=enum_is(s,obs_attr(s,u,"kind"),"game_state.UnitKind","ELITE");auto& chosen=elite?moved_elite:moved_regular;auto& remain=elite?kept_elite:kept_regular;(static_cast<int64_t>(chosen.size())<(elite?e:r)?chosen:remain).push_back(u);}require(r<=0||static_cast<int64_t>(moved_regular.size())>=r,"Not enough participating Regulars");require(e<=0||static_cast<int64_t>(moved_elite.size())>=e,"Not enough participating Elites");
        auto movable=[&](uint64_t leader){return !am_saruman(s,leader)&&am_leader_side(s,leader)==req.side&&(!req.battle_context||eligible_leaders.count(leader));};if(l>0){int64_t available=0;for(auto leader:leaders)available+=movable(leader)&&(n<0||object_type(s,leader)!="game_state.Nazgul");l=std::min(l,available);}std::set<uint64_t> selected,nazgul;
        if(n>=0){for(auto leader:leaders)if(static_cast<int64_t>(nazgul.size())<n&&movable(leader)&&object_type(s,leader)=="game_state.Nazgul"){nazgul.insert(leader);moving.push_back(leader);}}
        int64_t taken=0;for(bool plain:{true,false})for(auto leader:leaders)if(taken<l&&crl_plain(s,leader)==plain&&movable(leader)&&(n<0||object_type(s,leader)!="game_state.Nazgul")){selected.insert(leader);++taken;}
        for(auto leader:leaders)if(!nazgul.count(leader))(selected.count(leader)?moving:kept).push_back(leader);require(l<=0||taken>=l,"Not enough participating Leaders");cap_check(moved_elite.size()+moved_regular.size());auto remained=kept_elite;remained.insert(remained.end(),kept_regular.begin(),kept_regular.end());remained.insert(remained.end(),others.begin(),others.end());am_assign_list(s,src,"units",remained);am_assign_list(s,src,"leaders",kept);if(remained.empty()&&kept.empty())am_erase(s,from_key);if(dst==missing){dst=am_new_army(s,to_region);am_insert(s,to_key,dst);}moved_elite.insert(moved_elite.end(),moved_regular.begin(),moved_regular.end());am_extend(s,dst,"units",moved_elite);am_extend(s,dst,"leaders",moving);
        arriving_leaders=moving;
    }
    movement_entry_effects(s,tables,to,req.side,arriving_leaders);crl_orphans(s);const auto arrivals=child_edges(s,obs_attr(s,dst,"units"));if(!arrivals.empty()&&std::all_of(arrivals.begin(),arrivals.end(),[&](uint64_t unit){return ctx_unit_side(s,unit)==req.side;}))crs_capture(s,tables,to,req.side);
}
std::unique_ptr<Snapshot> combat_relocate(const Snapshot& source,const Snapshot& tables,const crl_Request& req){auto result=std::make_unique<Snapshot>(source);crl_move(*result,tables,req);return ac_compact(*result);}

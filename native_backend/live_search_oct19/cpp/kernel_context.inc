// Exact _kernel_ctx projection. No probability computation here.
uint64_t kc_copy(Snapshot& out,const Snapshot& in,uint64_t n,std::unordered_map<uint64_t,uint64_t>& memo){
    if(n==missing)return rr_scalar(out,WOTR_NONE);auto old=memo.find(n);if(old!=memo.end())return old->second;auto v=in.nodes[n];auto id=out.nodes.size();memo[n]=id;out.nodes.push_back(v);
    if(v.tag==WOTR_STRING||v.tag==WOTR_BYTES||v.tag==WOTR_BIGINT){out.nodes[id].offset=out.bytes.size();out.bytes.insert(out.bytes.end(),in.bytes.begin()+v.offset,in.bytes.begin()+v.offset+v.count);}
    else if(v.tag>=WOTR_LIST&&v.tag<=WOTR_ENUM){std::vector<uint64_t> xs;for(auto x:child_edges(in,n))xs.push_back(kc_copy(out,in,x,memo));set_edges(out,id,xs);if(v.flags==1)out.nodes[id].integer=kc_copy(out,in,v.integer,memo);}return id;
}
int64_t kc_integer(const Snapshot& s,uint64_t n,int64_t fallback){
    if(!truth(s,n))return fallback;const auto& v=s.nodes[n];if(v.tag==WOTR_INT||v.tag==WOTR_BOOL)return v.integer;if(v.tag==WOTR_FLOAT){require(std::isfinite(v.real)&&v.real>=double(INT64_MIN)&&v.real<double(INT64_MAX),"Kernel integer out of native range");return int64_t(v.real);}if(v.tag==WOTR_STRING){auto text=cbp_strip(std::string(::text(s,n)));if(!text.empty()&&text.front()=='+')text.erase(text.begin());int64_t result=0;auto parsed=std::from_chars(text.data(),text.data()+text.size(),result);require(parsed.ec==std::errc{}&&parsed.ptr==text.data()+text.size(),"Invalid kernel integer string");return result;}throw std::invalid_argument("Unsupported kernel integer input");
}
std::unique_ptr<Snapshot> native_kernel_context(const Snapshot& state,const Snapshot& tables,const Snapshot& info,const char* atk_id,const char* def_id,bool defer){
    sm_Builder b(info);auto nil=b.nil;auto tuple=[&](const std::vector<uint64_t>& xs){return b.container(WOTR_TUPLE,xs);};auto boolean=[&](bool v){return rr_scalar(b.out,WOTR_BOOL,v);};auto nation=[&](const char* n){return b.container(WOTR_ENUM,{b.str("game_state.Nation"),b.str(n)});};
    auto g=[&](const char* k){return field(info,info.root,k,false);};auto required=[&](const char* k){return field(info,info.root,k);};const int attacker=ctx_side(info,required("atk_side")),defender=ctx_side(info,required("def_side"));const std::string atk_region(text(info,required("atk_region"))),def_region(text(info,required("def_region")));
    // The existing partitioner reads only its explicit frozen-rearguard context.
    // Copy those small rosters/context, never the whole state or round cursor.
    Snapshot work;work.root=rr_scalar(work,WOTR_NONE);std::unordered_map<uint64_t,uint64_t> state_memo,info_memo;auto rear=g("attacker_rearguard");uint64_t context;
    if(!ctx_none(info,rear))context=ev_dict(work,{{"attacker_rearguard",kc_copy(work,info,rear,info_memo)}});
    else{auto pc=obs_attr(state,state.root,"pending_combat",false),old=ctx_none(state,pc)?missing:field(state,pc,"attacker_rearguard",false);context=ev_dict(work,{{"attacker_rearguard",kc_copy(work,state,old,state_memo)}});}
    auto army=[&](const std::string& region,int side){auto original=cbs_lookup(state,region);auto copied=ctx_none(state,original)?missing:kc_copy(work,state,original,state_memo);auto part=ca_partition(work,copied,region,side,context);int64_t regular=0,elite=0,isengard=0;for(auto u:part.units){if(enum_is(work,obs_attr(work,u,"kind"),"game_state.UnitKind","REGULAR"))++regular;else if(enum_is(work,obs_attr(work,u,"nation"),"game_state.Nation","ISENGARD"))++isengard;else ++elite;}
        require(regular+elite+isengard>0,"empty battle side");std::vector<uint64_t> leaders;for(auto leader:part.leaders){auto type=object_type(work,leader);std::string kind="leader",name;int64_t level=1,leadership=1;uint64_t own=nil;if(type=="game_state.Nazgul")kind="nazgul";else if(type=="game_state.Companion"){kind="companion";sm_Builder reader(work);name=reader.string(obs_attr(work,leader,"name"));level=kc_integer(work,obs_attr(work,leader,"level",false),1);leadership=kc_integer(work,obs_attr(work,leader,"leadership",false),1);}else if(type=="game_logic.Minion"){kind="minion";sm_Builder reader(work);name=reader.string(obs_attr(work,leader,"name",false));own=nation("SAURON");}leaders.push_back(tuple({b.str(kind),b.str(name),b.integer(level),b.integer(leadership),own}));}
        const auto base=nation(side==0?"GONDOR":"SAURON");return tuple({b.integer(regular),b.integer(elite),base,base,tuple(leaders),b.integer(isengard),nation("ISENGARD")});
    };
    const auto attacker_spec=army(atk_region,attacker),defender_spec=army(def_region,defender);
    auto card=[&](const char* id){if(!id||!*id)return nil;auto c=field(tables,field(tables,tables.root,"cards"),id,false);if(ctx_none(tables,c))throw std::invalid_argument("no combat side for '"+std::string(id)+"'");auto name=obs_attr(tables,c,"combat_name",false);if(ctx_none(tables,name)||cbp_strip(std::string(text(tables,name))).empty())throw std::invalid_argument("no combat side for '"+std::string(id)+"'");return b.str(text(tables,name));};
    bool siege=truth(info,g("is_siege"));auto meta=field(tables,field(tables,tables.root,"board_regions"),sanitize_name(def_region).c_str(),false);bool city=!ctx_none(tables,meta)&&!siege&&(truth(tables,field(tables,meta,"is_city",false))||truth(tables,field(tables,meta,"is_fort",false)));
    auto choices=g("choices");std::map<std::string,uint64_t> chosen;if(truth(info,choices)){for(auto k:{"atk_casualty_policy","def_casualty_policy","atk_effect_count","def_effect_count","atk_effect_target","def_effect_target"}){auto v=field(info,choices,k,false);if(!ctx_none(info,v))chosen[k]=b.raw(v);}for(auto k:{"attacker_dice_reduction","defender_dice_reduction"}){auto v=kc_integer(info,field(info,choices,k,false),0);if(v)chosen[k]=b.integer(v);}if(truth(info,field(info,choices,"disable_city_defense",false)))chosen["disable_city_defense"]=boolean(true);}
    std::vector<uint64_t> ch;for(auto [k,v]:chosen)ch.push_back(tuple({b.str(k),v}));bool saruman=false;auto armies=child_edges(state,obs_attr(state,state.root,"armies"));for(size_t i=1;i<armies.size();i+=2)for(auto l:child_edges(state,obs_attr(state,armies[i],"leaders")))if(object_type(state,l)=="game_logic.Minion"&&cp_has(cp_lower(text(state,obs_attr(state,l,"name"))),"saruman"))saruman=true;
    b.out.root=tuple({attacker_spec,defender_spec,card(atk_id),card(def_id),boolean(siege),boolean(city),b.raw(g("gtw_shine")),tuple(ch),boolean(defer),nil,nil,boolean(saruman)});return std::make_unique<Snapshot>(b.out);
}

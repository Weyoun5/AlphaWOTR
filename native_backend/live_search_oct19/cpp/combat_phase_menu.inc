// Remaining exact ordered combat phase menus, including optional advance splits.
int cpm_settlement(const Snapshot& s,const Snapshot& tables,std::string_view region){const auto key=sanitize_name(region);const auto meta=ctx_get(tables,field(tables,tables.root,"board_regions"),key);if(ctx_none(tables,meta)||(!truth(tables,field(tables,meta,"is_town",false))&&!truth(tables,field(tables,meta,"is_city",false))&&!truth(tables,field(tables,meta,"is_stronghold",false))))return -1;const auto nation=ctx_get(tables,field(tables,tables.root,"region_nations"),key);if(ctx_none(tables,nation))return -1;const int native=fp_nation(ctx_nation(tables,nation))?0:1;return contains_string(s,ctx_side_value(s,obs_attr(s,s.root,"enemy_controlled"),1-native),key)?1-native:native;}
void cpm_retreat(const Snapshot& s,const Snapshot& tables,uint64_t pc,bool defender,am_Builder& b,std::vector<uint64_t>& rows){
    const int side=cbb_side(s,pc,defender?1:0);const auto region=sanitize_name(text(s,field(s,pc,defender?"defender_region":"attacker_region")));const auto adj=ctx_get(s,obs_attr(s,obs_attr(s,s.root,"board"),"_adj"),region);if(ctx_none(s,adj))return;
    auto neighbors=child_edges(s,adj);std::sort(neighbors.begin(),neighbors.end(),[&](uint64_t a,uint64_t c){return text(s,a)<text(s,c);});
    for(auto entry:neighbors){const std::string name(text(s,entry)),key=sanitize_name(name);const auto army=mu_army(s,key);bool own=false,enemy=false;if(army!=missing)for(auto unit:child_edges(s,obs_attr(s,army,"units")))(ctx_unit_side(s,unit)==side?own:enemy)=true;const bool own_siege=contains_string(s,obs_attr(s,s.root,"besieged_strongholds",false),key)&&at_controller(s,tables,key)==1-side&&own;if((enemy||cpm_settlement(s,tables,name)==1-side)&&!own_siege)continue;rows.push_back(b.row(-1,"combat_retreat",{b.str("to_region"),b.str(name)}));}
}
std::unique_ptr<Snapshot> native_combat_phase_actions(const Snapshot& s,const Snapshot& tables,int side){
    require(side==0||side==1,"Combat phase owner must be FP or SH");const auto pc=obs_attr(s,s.root,"pending_combat"),phase=field(s,pc,"phase"),owner=field(s,pc,"deciding_side",false);am_Builder b;std::vector<uint64_t> rows;auto finish=[&](){b.out.root=b.container(WOTR_LIST,rows);return std::make_unique<Snapshot>(std::move(b.out));};if(!ctx_none(s,owner)&&!enum_is(s,owner,"game_state.Side",side==0?"FREE_PEOPLES":"SHADOW"))return finish();
    const std::string stage(text(s,phase));for(const char* guarded:{"attacker_combat_card","defender_combat_card","combat_round_result","attacker_continue","defender_retreat","defender_siege_choice","attacker_siege_decision"})if(stage==guarded){for(int role=0;role<2;++role)if(ca_units(s,text(s,field(s,pc,role==0?"attacker_region":"defender_region")),cbb_side(s,pc,role)).empty()){rows.push_back(b.row(-1,"combat_card_none",{b.str("side"),b.str(enum_is(s,owner,"game_state.Side","FREE_PEOPLES")?"fp":"sh")}));return finish();}break;}
    auto plain=[&](const char* action){rows.push_back(b.row(-1,action,{}));};
    if(stage=="attacker_continue"){plain("combat_continue");if(!truth(s,field(s,pc,"attacker_no_retreat",false)))plain("combat_cease");}
    else if(stage=="defender_siege_choice"){plain("retreat_into_siege");plain("combat_no_retreat");}
    else if(stage=="attacker_siege_decision")plain("siege_assault");
    else if(stage=="defender_retreat"){cpm_retreat(s,tables,pc,true,b,rows);if(!truth(s,field(s,pc,"is_siege",false))&&truth(s,field(s,pc,"stronghold_region",false))&&at_controller(s,tables,sanitize_name(text(s,field(s,pc,"defender_region"))))==cbb_side(s,pc,1))plain("retreat_into_siege");plain("combat_no_retreat");}
    else if(stage=="attacker_card_retreat")cpm_retreat(s,tables,pc,false,b,rows);
    else if(stage=="combat_round_result"){bool elite=false;for(auto unit:ca_units(s,text(s,field(s,pc,"attacker_region")),cbb_side(s,pc,0)))elite|=enum_is(s,obs_attr(s,unit,"kind"),"game_state.UnitKind","ELITE");if(elite)plain("siege_press");plain("siege_no_press");}
    else if(stage=="siege_trim"){const auto units=ca_units(s,text(s,field(s,pc,"trim_region")),cbb_side(s,pc,1));int64_t elite=0;for(auto u:units)elite+=enum_is(s,obs_attr(s,u,"kind"),"game_state.UnitKind","ELITE");const auto excess=std::max<int64_t>(0,static_cast<int64_t>(units.size())-5);for(int64_t k=0;k<=std::min(excess,elite);++k)rows.push_back(b.row(-1,"siege_trim",{b.str("elites_back"),b.integer(k),b.str("excess"),b.integer(excess)}));}
    else if(stage=="victor_advance"){
        const std::string from(text(s,field(s,pc,"attacker_region"))),to(text(s,field(s,pc,"defender_region")));const int actor=cbb_side(s,pc,0);const auto army=mu_army(s,sanitize_name(from));if(army!=missing){const auto parts=ca_partition(s,army,from,actor,pc);int64_t regular=0,elite=0,nazgul=0,leaders=0;bool has_leader=false;for(auto u:parts.units)if(ctx_unit_side(s,u)==actor)(enum_is(s,obs_attr(s,u,"kind"),"game_state.UnitKind","REGULAR")?regular:elite)++;for(auto l:parts.leaders){const bool naz=object_type(s,l)=="game_state.Nazgul";nazgul+=actor==1&&naz;if(!naz&&!am_saruman(s,l)){has_leader=true;leaders+=am_leader_side(s,l)==actor;}}
            for(int64_t r=0;r<=regular;++r)for(int64_t e=0;e<=elite;++e){if(r+e==0)continue;const bool full=r+e==regular+elite;for(int64_t n=0;n<=nazgul;++n){const std::vector<bool> choices=has_leader?(full?std::vector<bool>{true}:std::vector<bool>{true,false}):std::vector<bool>{full};for(bool take:choices){std::vector<uint64_t> p={b.str("from"),b.str(from),b.str("to"),b.str(to),b.str("n_regular"),b.integer(r),b.str("n_elite"),b.integer(e),b.str("take_leaders"),rr_scalar(b.out,WOTR_BOOL,take),b.str("side"),b.str(actor==0?"fp":"sh")};if(nazgul){p.push_back(b.str("n_nazgul"));p.push_back(b.integer(n));}rows.push_back(b.row(-1,"victor_advance",p));}if(has_leader&&!full&&leaders>1)for(int64_t l=1;l<leaders;++l){std::vector<uint64_t> p={b.str("from"),b.str(from),b.str("to"),b.str(to),b.str("n_regular"),b.integer(r),b.str("n_elite"),b.integer(e),b.str("take_leaders"),rr_scalar(b.out,WOTR_BOOL,1),b.str("n_leaders"),b.integer(l),b.str("side"),b.str(actor==0?"fp":"sh")};if(nazgul){p.push_back(b.str("n_nazgul"));p.push_back(b.integer(n));}rows.push_back(b.row(-1,"victor_advance",p));}}}
        }plain("victor_stay");
    }else throw std::invalid_argument("Unsupported combat phase menu");if(rows.empty())plain("pass");return finish();
}

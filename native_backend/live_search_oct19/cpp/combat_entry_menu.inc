// Exact ordered legal combat-card, Shine and Words-of-Power menus.
bool ccm_hobbit(const Snapshot& s,uint64_t companion){const auto n=obs_attr(s,companion,"name",false);if(ctx_none(s,n)||s.nodes[n].tag!=WOTR_STRING)return false;const auto name=cbp_strip(cp_lower(text(s,n)));for(const char* known:{"meriadoc","meriadoc brandybuck","peregrin","peregrin took","frodo","frodo baggins","sam","samwise","sam gamgee","samwise gamgee"})if(name==known)return true;return false;}
bool ccm_legal(const Snapshot& s,const Snapshot& tables,uint64_t combat,uint64_t card,int role){
    if(ctx_none(tables,card)||cbp_strip(std::string(text(tables,obs_attr(tables,card,"combat_name")))).empty())return false;const auto army=obs_attr(s,combat,role==0?"attacker_army":"defender_army");const int side=enum_is(s,obs_attr(s,combat,role==0?"attacker_side":"defender_side"),"game_state.Side","FREE_PEOPLES")?0:1;if(!enum_is(tables,obs_attr(tables,card,"side"),"game_state.Side",side==0?"FREE_PEOPLES":"SHADOW"))return false;
    if(cbp_strip(cp_lower(text(tables,obs_attr(tables,card,"combat_name"))))=="scouts"&&(role==0||truth(s,obs_attr(s,combat,"is_siege"))))return false;
    auto flag=[&](const char* key){return truth(tables,obs_attr(tables,card,key,false));};const auto companions=child_edges(s,obs_attr(s,combat,"companions_in_battle")),units=child_edges(s,obs_attr(s,army,"units")),leaders=child_edges(s,obs_attr(s,army,"leaders"));
    if(flag("requires_companion")&&companions.empty())return false;if(flag("requires_hobbit")&&!std::any_of(companions.begin(),companions.end(),[&](uint64_t c){return ccm_hobbit(s,c);}))return false;const auto nazgul=cp_number(s,combat,"nazgul_in_battle");if(flag("requires_nazgul")&&nazgul<1)return false;const auto minimum=obs_attr(tables,card,"min_nazgul_leadership");if(tables.nodes[minimum].integer>0&&(ctx_none(s,obs_attr(s,combat,"_shine_companion",false))?nazgul:0)<tables.nodes[minimum].integer)return false;
    if((flag("requires_elite")||flag("requires_fp_elite")||flag("requires_shadow_elite"))&&!std::any_of(units.begin(),units.end(),[&](uint64_t u){return enum_is(s,obs_attr(s,u,"kind"),"game_state.UnitKind","ELITE");}))return false;if(flag("requires_leader")&&leaders.empty()&&companions.empty())return false;
    auto named=[&](const std::vector<uint64_t>& figures){const auto req=obs_attr(tables,card,"requires_character_in_battle",false);if(!truth(tables,req))return true;std::string names;for(auto c:figures){if(!names.empty())names+=' ';names+=cp_lower(text(s,obs_attr(s,c,"name")));}for(auto wanted:child_edges(tables,req))if(cp_has(names,text(tables,wanted)))return true;return false;};if(!named(companions))return false;
    if(flag("requires_se_elite")&&!std::any_of(units.begin(),units.end(),[&](uint64_t u){return enum_is(s,obs_attr(s,u,"kind"),"game_state.UnitKind","ELITE")&&enum_is(s,obs_attr(s,u,"nation"),"game_state.Nation","SOUTHRON_EASTERLINGS");}))return false;if(flag("requires_isengard_unit")&&!std::any_of(units.begin(),units.end(),[&](uint64_t u){return enum_is(s,obs_attr(s,u,"nation"),"game_state.Nation","ISENGARD");}))return false;if(flag("requires_stronghold")&&!truth(s,obs_attr(s,combat,"is_siege")))return false;
    const auto region=sanitize_name(text(s,obs_attr(s,combat,"defender_region")));
    if(flag("requires_fellowship_region")){
        const auto fellowship=obs_attr(s,s.root,"fellowship");
        // The retained gateway is bookkeeping; Mordor Track is no map region.
        if(truth(s,obs_attr(s,fellowship,"mordor_entered")) ||
           region!=glb_fellowship_key(s,fellowship))return false;
    }
    if(flag("requires_fp_nation")&&!contains_string(tables,field(tables,tables.root,"combat_fp_nation_regions"),region))return false;
    const auto restrictions=obs_attr(tables,card,"region_restrictions",false);if(truth(tables,restrictions)){
        auto has=[&](std::string_view r){return contains_string(tables,restrictions,r);};bool okay=false;if(has("moria")&&cp_has(cp_lower(text(tables,obs_attr(tables,card,"combat_req"))),"within two regions")){std::set<std::string> seen={"moria"},frontier=seen;for(int distance=0;distance<2;++distance){std::set<std::string> next;for(const auto& place:frontier){const auto adj=field(tables,field(tables,tables.root,"board_adj"),place.c_str(),false);if(!ctx_none(tables,adj))for(auto neighbor:child_edges(tables,adj)){const auto name=sanitize_name(text(tables,neighbor));if(seen.insert(name).second)next.insert(name);}}frontier=std::move(next);}okay=seen.count(region)!=0;}
        else{okay=(has("fangorn")&&region=="fangorn")||(has("orthanc")&&region=="orthanc")||(has("moria")&&region=="moria");if(has("rohan")){const auto parent=field(tables,field(tables,tables.root,"board_region_parent_names"),region.c_str(),false);okay|=text_is(tables,parent,"rohan");}}if(!okay)return false;
    }
    std::vector<uint64_t> mapped;bool minion=false;for(const char* key:{"attacker_army","defender_army"})for(auto leader:child_edges(s,obs_attr(s,obs_attr(s,combat,key),"leaders"))){if(object_type(s,leader)=="game_state.Companion")mapped.push_back(leader);minion|=object_type(s,leader)=="game_logic.Minion";}
    if(flag("requires_hobbit")&&!std::any_of(mapped.begin(),mapped.end(),[&](uint64_t c){return ccm_hobbit(s,c);}))return false;if(!named(mapped)||(flag("requires_companion")&&mapped.empty()))return false;const auto printed=obs_attr(tables,card,"card_name");if((text_is(tables,printed,"Mithril Coat and Sting")||text_is(tables,printed,"Bilbo's Song"))&&!minion)return false;if(truth(s,obs_attr(s,combat,"is_siege"))&&cp_has(cp_lower(text(tables,obs_attr(tables,card,"combat_effect"))),"retreat your army"))return false;return true;
}
std::unique_ptr<Snapshot> native_combat_entry_actions(const Snapshot& source,const Snapshot& tables,int side){
    require(side==0||side==1,"Combat actor must be FP or SH");const auto pc=obs_attr(source,source.root,"pending_combat"),phase=field(source,pc,"phase");am_Builder b;std::vector<uint64_t> rows;const auto owner=field(source,pc,"deciding_side",false);auto finish=[&](){b.out.root=b.container(WOTR_LIST,rows);return std::make_unique<Snapshot>(std::move(b.out));};if(!ctx_none(source,owner)&&!enum_is(source,owner,"game_state.Side",side==0?"FREE_PEOPLES":"SHADOW"))return finish();
    if(text_is(source,phase,"combat_card_reveal"))return finish();if(text_is(source,phase,"fp_shine")){rows.push_back(b.row(-1,"shine",{}));rows.push_back(b.row(-1,"shine_none",{}));return finish();}
    if(text_is(source,phase,"combat_effect_choice")){const auto effect=field(source,pc,"effect_choice");require(text_is(source,field(source,effect,"stage"),"pre")&&text_is(source,field(source,effect,"effect"),"words_of_power"),"Unsupported pre-combat choice menu");for(auto target:child_edges(source,field(source,effect,"targets")))rows.push_back(b.row(-1,"combat_effect_choice",{b.str("card_id"),b.str(text(source,field(source,effect,"card_id"))),b.str("target"),b.str(text(source,target))}));return finish();}
    require(text_is(source,phase,"attacker_combat_card")||text_is(source,phase,"defender_combat_card"),"Unsupported combat entry menu");for(int role=0;role<2;++role)if(ca_units(source,text(source,field(source,pc,role==0?"attacker_region":"defender_region")),cbb_side(source,pc,role)).empty()){rows.push_back(b.row(-1,"combat_card_none",{b.str("side"),b.str(enum_is(source,owner,"game_state.Side","FREE_PEOPLES")?"fp":"sh")}));return finish();}
    const int role=text_is(source,phase,"attacker_combat_card")?0:1,actor=cbb_side(source,pc,role);const auto hand_owner=ctx_side_value(source,obs_attr(source,source.root,"hands"),actor);std::vector<std::string> candidates;std::set<std::string> seen;if(!ctx_none(source,hand_owner))for(auto id:child_edges(source,obs_attr(source,hand_owner,"hand")))if(source.nodes[id].tag==WOTR_STRING){const std::string name(text(source,id));if(seen.insert(name).second)candidates.push_back(name);}std::string table_id;if(actor==1){const auto balrog=cau_persistent(source,"BALROG_OF_MORIA");if(balrog!=missing){const std::string id(text(source,obs_attr(source,balrog,"card_id")));if(seen.insert(id).second){table_id=id;candidates.push_back(id);}}}
    if(!candidates.empty()){
        Snapshot scratch(source);const auto combat=cbs_setup(scratch,tables,text(source,field(source,pc,"attacker_region")),text(source,field(source,pc,"defender_region")),rr_scalar(scratch,WOTR_NONE),rr_scalar(scratch,WOTR_NONE),truth(source,field(source,pc,"is_siege",false)),cbb_side(source,pc,0));const bool fp_ok=actor!=0||sanitize_name(text(source,field(source,pc,"defender_region")))!="minas tirith"||cau_persistent(source,"DENETHORS_FOLLY")==missing;
        if(fp_ok)for(const auto& cid:candidates){const auto card=field(tables,field(tables,tables.root,"cards"),cid.c_str(),false);if(ccm_legal(scratch,tables,combat,card,role)){std::vector<uint64_t> params={b.str("card_id"),b.str(cid),b.str("side"),b.str(actor==0?"fp":"sh")};if(cid==table_id){params.push_back(b.str("from_table"));params.push_back(rr_scalar(b.out,WOTR_BOOL,1));}rows.push_back(b.row(-1,"combat_card_play",params));}}
    }
    rows.push_back(b.row(-1,"combat_card_none",{b.str("side"),b.str(actor==0?"fp":"sh")}));return finish();
}

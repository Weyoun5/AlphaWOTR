    fm_Result result;result.state=std::move(owned.state);result.random=std::move(owned.random);cau_finish(*result.state,tables,result.random.get(),attacker_side,events,rows);result.state=ac_compact(*result.state);events.out.root=events.container(WOTR_LIST,rows);result.events=std::make_unique<Snapshot>(std::move(events.out));return result;

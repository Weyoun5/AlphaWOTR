// Complete learned casualty_allocate action, including automatic owner changes.
fm_Result apply_combat_casualty(const Snapshot& source,const Snapshot& tables,const void* random_source,int64_t selection_index){
    require(selection_index>=0,"Casualty action index must be nonnegative");crr_Result owned;owned.state=action_clone(source);owned.random.reset(wotr_random_clone(random_source));if(!owned.random)throw std::invalid_argument(wotr_random_last_error());auto& s=*owned.state;
    rr_set_attr(s,s.root,"_casualty_operations",cp_container(s,WOTR_LIST,{}));cau_dedupe(s);const auto pc=obs_attr(s,s.root,"pending_combat");require(text_is(s,field(s,pc,"phase"),"casualty_allocation"),"No active casualty allocation");
    const auto owner=field(s,pc,"alloc_stage");require(text_is(s,owner,"attacker")||text_is(s,owner,"defender"),"Invalid casualty owner stage");const bool attacker=text_is(s,owner,"attacker");const std::string role=attacker?"attacker":"defender",key=attacker?"atk_hits":"def_hits",region(text(s,field(s,pc,(role+"_region").c_str())));const int side=enum_is(s,field(s,pc,(role+"_side").c_str()),"game_state.Side","FREE_PEOPLES")?0:1,attacker_side=enum_is(s,field(s,pc,"attacker_side"),"game_state.Side","FREE_PEOPLES")?0:1;
    const auto amount=field(s,pc,key.c_str(),false);const int64_t hits=ctx_none(s,amount)?0:typed(s,amount,WOTR_INT,"Casualty hits must be integer").integer;const auto options=ca_operations(s,region,side,hits);require(static_cast<uint64_t>(selection_index)<options.size(),"Casualty action index is not legal");const auto selected=options[static_cast<size_t>(selection_index)];
    rr_set_attr(s,s.root,"_ring_free_side",rr_scalar(s,WOTR_NONE));if(truth(s,obs_attr(s,s.root,"_declare_phase",false)))rr_set_attr(s,s.root,"_declare_phase",rr_scalar(s,WOTR_BOOL,0));

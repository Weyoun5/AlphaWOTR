// Full combat phase transitions and siege payments, no sampled decision skipped.
struct cpl_Request {std::string kind;int64_t elites_back=0;std::string nation;bool has_nation=false;};
std::string cpl_lower(std::string value){for(auto& c:value)if(c>='A'&&c<='Z')c=static_cast<char>(c-'A'+'a');return value;}
bool cpl_replacement(Snapshot& s,const Snapshot& tables,uint64_t nation){
    const std::string name(enum_member(s,nation,"game_state.Nation"));const auto box=obs_attr(s,s.root,"fp_casualties",false),counts=ctx_nation_value(s,box,name),regular=ctx_none(s,counts)?missing:field(s,counts,"regular",false);uint64_t source=rr_scalar(s,WOTR_NONE);
    if(fp_nation(name)&&!ctx_none(s,regular)&&s.nodes[regular].integer>0){source=rr_string(s,"cas");cp_put(s,counts,"regular",rr_scalar(s,WOTR_INT,s.nodes[regular].integer-1));}else if(mu_available(s,tables,name,"regular")>0)source=rr_string(s,"pool");
    auto log=obs_attr(s,s.root,"_dg_src_log",false);if(ctx_none(s,log)){log=cp_container(s,WOTR_LIST,{});rr_set_attr(s,s.root,"_dg_src_log",log);}auto entries=child_edges(s,log);entries.push_back(cp_container(s,WOTR_TUPLE,{nation,source}));set_edges(s,log,entries);return !ctx_none(s,source);
}
void cpl_siege(Snapshot& s,const Snapshot& tables,uint64_t pc){
    const auto destination=sanitize_name(text(s,field(s,pc,"defender_region")));auto besieged=obs_attr(s,s.root,"besieged_strongholds",false);if(besieged==missing){besieged=cp_container(s,WOTR_SET,{});rr_set_attr(s,s.root,"besieged_strongholds",besieged);}me_set_member(s,besieged,destination,true);
    if(sanitize_name(text(s,field(s,pc,"attacker_region")))!=destination){crl_Request request;request.from=std::string(text(s,field(s,pc,"attacker_region")));request.to=std::string(text(s,field(s,pc,"defender_region")));request.side=cbb_side(s,pc,0);request.battle_context=true;crl_move(s,tables,request,pc);rr_set_attr(s,s.root,"_siege_movein",cp_container(s,WOTR_DICT,{rr_string(s,"from"),rr_string(s,sanitize_name(request.from)),rr_string(s,"to"),rr_string(s,destination),rr_string(s,"side"),rr_string(s,request.side==0?"FREE_PEOPLES":"SHADOW")}));cp_put(s,pc,"attacker_region",field(s,pc,"defender_region"));}
    const auto army=mu_army(s,destination);bool present=false;if(army!=missing)for(auto unit:child_edges(s,obs_attr(s,army,"units")))present|=ctx_unit_side(s,unit)==cbb_side(s,pc,0);if(!present&&ctx_none(s,obs_attr(s,s.root,"_siege_movein_failed",false)))rr_set_attr(s,s.root,"_siege_movein_failed",rr_string(s,"post-condition: no attacker units at "+destination));
}
fm_Result apply_combat_phase(const Snapshot& source,const Snapshot& tables,const void* random_source,const cpl_Request& request){
    crr_Result owned;owned.state=action_clone(source);owned.random.reset(wotr_random_clone(random_source));if(!owned.random)throw std::invalid_argument(wotr_random_last_error());auto& s=*owned.state;rr_set_attr(s,s.root,"_casualty_operations",cp_container(s,WOTR_LIST,{}));cau_dedupe(s);const auto pc=obs_attr(s,s.root,"pending_combat");require(!ctx_none(s,pc),"Combat phase action needs pending battle");const int attacker=cbb_side(s,pc,0);am_Builder events;std::vector<uint64_t> rows;
    if(!cbc_stale(owned,tables,&events,&rows)){
        rr_set_attr(s,s.root,"_ring_free_side",rr_scalar(s,WOTR_NONE));if(truth(s,obs_attr(s,s.root,"_declare_phase",false)))rr_set_attr(s,s.root,"_declare_phase",rr_scalar(s,WOTR_BOOL,0));const auto& kind=request.kind;
        if(kind=="pass"){ // Package W (P6): the frozen pass precedence (ai.py:10272-10300): a pending Army pair, then a pending Muster pair, then the battle (any phase)
            const auto pad=obs_attr(s,s.root,"pending_army_move_die",false),pmd=obs_attr(s,s.root,"pending_muster_die",false);
            if(!ctx_none(s,pad)){const int pside=ctx_side(s,obs_attr(s,s.root,"pending_army_move_side"));const auto idx=typed(s,pad,WOTR_INT,"pending army die must be integer").integer;const auto pool=child_edges(s,pa_pool(s,pside));
                if(idx>=0&&static_cast<size_t>(idx)<pool.size()&&!truth(s,obs_attr(s,pool[idx],"used")))rr_set_attr(s,pool[idx],"used",rr_scalar(s,WOTR_BOOL,1));
                for(const char* key:{"pending_army_move_die","pending_army_move_from","pending_army_move_side","pending_army_move_preexist"})rr_set_attr(s,s.root,key,rr_scalar(s,WOTR_NONE));}
            else if(!ctx_none(s,pmd)){const int pside=ctx_side(s,obs_attr(s,s.root,"pending_muster_side"));const auto idx=typed(s,pmd,WOTR_INT,"pending muster die must be integer").integer;const auto pool=child_edges(s,pa_pool(s,pside));
                if(idx>=0&&static_cast<size_t>(idx)<pool.size())rr_set_attr(s,pool[idx],"used",rr_scalar(s,WOTR_BOOL,1));
                for(const char* key:{"pending_muster_die","pending_muster_first_type","pending_muster_region","pending_muster_side"})rr_set_attr(s,s.root,key,rr_scalar(s,WOTR_NONE));}
            else{rr_set_attr(s,s.root,"pending_combat",rr_scalar(s,WOTR_NONE));cbe_palantir(s);}}
        else if(kind=="combat_cease"||kind=="siege_no_press"||kind=="victor_stay"){crs_witch_king_draw(s,pc,&events,&rows);rr_set_attr(s,s.root,"pending_combat",rr_scalar(s,WOTR_NONE));cbe_palantir(s);}
        else if(kind=="combat_continue"){cp_put(s,pc,"phase",rr_string(s,"defender_retreat"));cp_put(s,pc,"deciding_side",field(s,pc,"defender_side"));}
        else if(kind=="combat_no_retreat"){cp_erase(s,pc,"_card_retreat_mandatory");if(truth(s,field(s,pc,"is_siege"))){cp_put(s,pc,"phase",rr_string(s,"attacker_siege_decision"));cp_put(s,pc,"deciding_side",field(s,pc,"attacker_side"));}else cbb_run(owned,tables,-1,events,rows);}
        else if(kind=="siege_assault"){cp_put(s,pc,"is_siege",rr_scalar(s,WOTR_BOOL,1));cbb_run(owned,tables,1,events,rows);}
        else if(kind=="siege_continue"){cpl_siege(s,tables,pc);crs_witch_king_draw(s,pc,&events,&rows);rr_set_attr(s,s.root,"pending_combat",rr_scalar(s,WOTR_NONE));cbe_palantir(s);}
        else if(kind=="siege_press"){
            const std::string region(sanitize_name(text(s,field(s,pc,"attacker_region"))));const auto army=mu_army(s,region);require(army!=missing,"No participating army can pay siege press");{const auto eligible=ca_units(s,region,attacker);auto deployed=child_edges(s,obs_attr(s,army,"units"));auto chosen=std::find_if(deployed.begin(),deployed.end(),[&](uint64_t unit){return enum_is(s,obs_attr(s,unit,"kind"),"game_state.UnitKind","ELITE")&&std::find(eligible.begin(),eligible.end(),unit)!=eligible.end()&&(!request.has_nation||cpl_lower(su_nation_value(enum_member(s,obs_attr(s,unit,"nation"),"game_state.Nation")))==cpl_lower(request.nation));});require(chosen!=deployed.end(),"No participating Elite of the requested nation can pay siege press");const auto unit=*chosen,nation=obs_attr(s,unit,"nation");if(cpl_replacement(s,tables,nation))*chosen=mu_object(s,"game_state.Unit",{{"nation",nation},{"kind",mu_enum(s,"game_state.UnitKind","REGULAR")}});else deployed.erase(chosen);am_assign_list(s,army,"units",deployed);if(attacker==0)cbp_book(s,nation,"elite");}cbb_run(owned,tables,1,events,rows);
        }else if(kind=="retreat_into_siege"){
            crs_witch_king_draw(s,pc,&events,&rows);
            const auto defender=field(s,pc,"defender_region");if(sanitize_name(text(s,field(s,pc,"attacker_region")))!=sanitize_name(text(s,defender))){std::vector<uint64_t> pairs={rr_string(s,"phase"),rr_string(s,"victor_advance")};for(const char* key:{"attacker_rearguard","attacker_region","defender_region","attacker_side","defender_side"}){const auto value=field(s,pc,key,false);pairs.push_back(rr_string(s,key));pairs.push_back(value==missing?rr_scalar(s,WOTR_NONE):value);}pairs.insert(pairs.end(),{rr_string(s,"deciding_side"),field(s,pc,"attacker_side"),rr_string(s,"is_siege"),rr_scalar(s,WOTR_BOOL,0),rr_string(s,"rounds_fought"),field(s,pc,"rounds_fought",false)==missing?rr_scalar(s,WOTR_INT,0):field(s,pc,"rounds_fought"),rr_string(s,"post_siege_retreat"),rr_scalar(s,WOTR_BOOL,1)});rr_set_attr(s,s.root,"pending_combat",cp_container(s,WOTR_DICT,pairs));}
            else{auto besieged=obs_attr(s,s.root,"besieged_strongholds",false);if(besieged==missing){besieged=cp_container(s,WOTR_SET,{});rr_set_attr(s,s.root,"besieged_strongholds",besieged);}const std::string region(sanitize_name(text(s,defender)));me_set_member(s,besieged,region,true);cp_put(s,pc,"is_siege",rr_scalar(s,WOTR_BOOL,1));const auto army=mu_army(s,region);int64_t count=0;if(army!=missing)for(auto unit:child_edges(s,obs_attr(s,army,"units")))count+=ctx_unit_side(s,unit)==cbb_side(s,pc,1);const bool trim=count>5;if(trim){cp_put(s,pc,"phase",rr_string(s,"siege_trim"));cp_put(s,pc,"deciding_side",field(s,pc,"defender_side"));cp_put(s,pc,"trim_region",rr_string(s,region));}cpl_siege(s,tables,pc);if(!trim){rr_set_attr(s,s.root,"pending_combat",rr_scalar(s,WOTR_NONE));cbe_palantir(s);}}
        }else if(kind=="siege_trim"){
            require(text_is(s,field(s,pc,"phase"),"siege_trim"),"No siege trim is pending");const auto army=mu_army(s,sanitize_name(text(s,field(s,pc,"trim_region"))));if(army!=missing){const auto deployed=child_edges(s,obs_attr(s,army,"units"));std::vector<uint64_t> elites,regulars;for(auto unit:deployed)if(ctx_unit_side(s,unit)==cbb_side(s,pc,1))(enum_is(s,obs_attr(s,unit,"kind"),"game_state.UnitKind","ELITE")?elites:regulars).push_back(unit);const int64_t excess=static_cast<int64_t>(elites.size()+regulars.size())-5;if(excess>0){const auto k=std::max<int64_t>(0,std::min<int64_t>({request.elites_back,excess,static_cast<int64_t>(elites.size())}));std::set<uint64_t> back;for(int64_t i=0;i<k;++i)back.insert(elites[i]);for(int64_t i=0;i<excess-k&&i<static_cast<int64_t>(regulars.size());++i)back.insert(regulars[i]);for(int64_t i=k;static_cast<int64_t>(back.size())<excess&&i<static_cast<int64_t>(elites.size());++i)back.insert(elites[i]);std::vector<uint64_t> keep;for(auto unit:deployed)if(!back.count(unit))keep.push_back(unit);am_assign_list(s,army,"units",keep);}}rr_set_attr(s,s.root,"pending_combat",rr_scalar(s,WOTR_NONE));cbe_palantir(s);
        }else throw std::invalid_argument("Combat phase action is not ported");
        cau_finish(*owned.state,tables,owned.random.get(),attacker,events,rows);
    }
    fm_Result result;result.state=ac_compact(*owned.state);result.random=std::move(owned.random);events.out.root=events.container(WOTR_LIST,rows);result.events=std::make_unique<Snapshot>(std::move(events.out));return result;
}

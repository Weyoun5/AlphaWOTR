// Live Onslaught magnitude and learned unit-payment decisions.
// No sacrifice or random roll occurs until the player chooses each payment.
int64_t co_number(const Snapshot& s,uint64_t dict,const char* key){return typed(s,field(s,dict,key),WOTR_INT,"Onslaught payment count must be integer").integer;}
int co_role(const Snapshot& s,uint64_t payment){const auto owner=field(s,payment,"owner");require(text_is(s,owner,"atk")||text_is(s,owner,"def"),"Invalid Onslaught owner");return text_is(s,owner,"atk")?0:1;}
std::vector<ca_Operation> co_options(const Snapshot& s,uint64_t pc,uint64_t payment){
    const int role=co_role(s,payment);const std::string prefix=role==0?"attacker":"defender";return ca_operations(s,text(s,field(s,pc,(prefix+"_region").c_str())),enum_is(s,field(s,pc,(prefix+"_side").c_str()),"game_state.Side","FREE_PEOPLES")?0:1,co_number(s,payment,"remaining"));
}
uint64_t co_option(Snapshot& s,const ca_Operation& option){return cp_container(s,WOTR_DICT,{rr_string(s,"nation"),rr_string(s,option.nation),rr_string(s,"kind"),rr_string(s,option.operation=="remove_regular"?"regular":"elite"),rr_string(s,"operation"),rr_string(s,option.operation=="reduce_elite"?"downgrade":"remove")});}
void co_advance(crr_Result& owned,const Snapshot& tables,am_Builder& events,std::vector<uint64_t>& rows){
    auto& s=*owned.state;const auto pc=obs_attr(s,s.root,"pending_combat"),payment=field(s,pc,"_onslaught_payment");const int role=co_role(s,payment);const std::string own=role==0?"attacker":"defender",other=role==0?"defender":"attacker";const auto side_node=field(s,pc,(own+"_side").c_str());const int side=enum_is(s,side_node,"game_state.Side","FREE_PEOPLES")?0:1;const std::string region(text(s,field(s,pc,(own+"_region").c_str()))),enemy_region(text(s,field(s,pc,(other+"_region").c_str())));const auto options=co_options(s,pc,payment);
    if(co_number(s,payment,"remaining")>0&&!options.empty()){
        cp_put(s,pc,"phase",rr_string(s,"combat_effect_choice"));cp_put(s,pc,"deciding_side",side_node);const auto effect=cp_container(s,WOTR_DICT,child_edges(s,payment));cp_put(s,effect,"stage",rr_string(s,"onslaught_payment"));cp_put(s,effect,"effect",rr_string(s,"onslaught_payment"));std::vector<uint64_t> choices;for(const auto& option:options)choices.push_back(co_option(s,option));cp_put(s,effect,"options",cp_container(s,WOTR_LIST,choices));cp_put(s,pc,"effect_choice",effect);return;
    }
    if(ca_units(s,region,side).empty())cbe_reconcile(s,region,side,owned.random.get());
    const auto count=co_number(s,payment,"paid");require(count>=0&&count<=4,"Onslaught paid hits exceed range");std::array<uint32_t,4> dice{};int64_t hits=0;if(count){cf_d6(owned.random.get(),dice.data(),static_cast<size_t>(count),4,0,cfc_active!=nullptr,"combat roll");std::vector<uint64_t> faces;for(int64_t i=0;i<count;++i){hits+=dice[i]>=4;faces.push_back(events.integer(dice[i]));}rows.push_back(events.row(-1,"dice_roll",{events.str("faces"),events.container(WOTR_LIST,faces),events.str("context"),events.str("Onslaught additional attack"),events.str("side"),events.str(side==1?"SH":"FP")}));}
    const bool enemy_present=!ca_units(s,enemy_region,1-side).empty();for(const char* key:{"_onslaught_payment","effect_choice","_finish_atk_dead","_finish_def_dead"})cp_erase(s,pc,key);
    cp_put(s,pc,"def_hits",rr_scalar(s,WOTR_INT,role==0&&enemy_present?hits:0));cp_put(s,pc,"atk_hits",rr_scalar(s,WOTR_INT,role==1&&enemy_present?hits:0));cp_put(s,pc,"alloc_stage",rr_string(s,"attacker"));cp_put(s,pc,"_p9_done",rr_scalar(s,WOTR_BOOL,1));cp_put(s,pc,"_onslaught_done",rr_scalar(s,WOTR_BOOL,1));if(!ca_enter(s,tables,pc))cbe_complete_allocated(owned,tables,&events,&rows);
}
fm_Result co_action(const Snapshot& source,const Snapshot& tables,const void* random_source,int64_t selection,bool payment_action){
    crr_Result owned;owned.state=action_clone(source);owned.random.reset(wotr_random_clone(random_source));if(!owned.random)throw std::invalid_argument(wotr_random_last_error());auto& s=*owned.state;rr_set_attr(s,s.root,"_casualty_operations",cp_container(s,WOTR_LIST,{}));cau_dedupe(s);const auto pc=obs_attr(s,s.root,"pending_combat"),effect=field(s,pc,"effect_choice");require(text_is(s,field(s,pc,"phase"),"combat_effect_choice"),"No combat effect choice is pending");const int attacker=enum_is(s,field(s,pc,"attacker_side"),"game_state.Side","FREE_PEOPLES")?0:1;rr_set_attr(s,s.root,"_ring_free_side",rr_scalar(s,WOTR_NONE));if(truth(s,obs_attr(s,s.root,"_declare_phase",false)))rr_set_attr(s,s.root,"_declare_phase",rr_scalar(s,WOTR_BOOL,0));
    if(payment_action){
        require(text_is(s,field(s,effect,"stage"),"onslaught_payment"),"No Onslaught payment is pending");const auto payment=field(s,pc,"_onslaught_payment");const auto options=co_options(s,pc,payment);require(selection>=0&&static_cast<size_t>(selection)<options.size(),"Onslaught payment index exceeds legal menu");const auto option=options[selection];const int role=co_role(s,payment);const std::string prefix=role==0?"attacker":"defender",region(text(s,field(s,pc,(prefix+"_region").c_str())));const int side=enum_is(s,field(s,pc,(prefix+"_side").c_str()),"game_state.Side","FREE_PEOPLES")?0:1;const auto cost=ca_apply(s,tables,region,side,co_number(s,payment,"remaining"),option.nation,option.operation);cp_put(s,payment,"paid",rr_scalar(s,WOTR_INT,crs_sum(co_number(s,payment,"paid"),cost)));cp_put(s,payment,"remaining",rr_scalar(s,WOTR_INT,co_number(s,payment,"remaining")-cost));
    }else{
        require(text_is(s,field(s,effect,"stage"),"post")&&text_is(s,field(s,effect,"effect"),"onslaught"),"No deferred Onslaught magnitude is pending");require(selection>=0&&selection<=co_number(s,effect,"max_count")&&selection<=4,"Onslaught magnitude exceeds offered cap");const int role=co_role(s,effect);const std::string prefix=role==0?"attacker":"defender";const int side=enum_is(s,field(s,pc,(prefix+"_side").c_str()),"game_state.Side","FREE_PEOPLES")?0:1;int64_t capacity=0;for(auto unit:ca_units(s,text(s,field(s,pc,(prefix+"_region").c_str())),side))capacity+=enum_is(s,obs_attr(s,unit,"kind"),"game_state.UnitKind","ELITE")?2:1;require(selection<=capacity,"Onslaught magnitude exceeds participating army");cp_put(s,pc,"_onslaught_payment",cp_container(s,WOTR_DICT,{rr_string(s,"owner"),field(s,effect,"owner"),rr_string(s,"card_id"),field(s,effect,"card_id"),rr_string(s,"count"),rr_scalar(s,WOTR_INT,selection),rr_string(s,"remaining"),rr_scalar(s,WOTR_INT,selection),rr_string(s,"paid"),rr_scalar(s,WOTR_INT,0)}));
    }
    am_Builder events;std::vector<uint64_t> rows;co_advance(owned,tables,events,rows);cau_finish(*owned.state,tables,owned.random.get(),attacker,events,rows);fm_Result result;result.state=ac_compact(*owned.state);result.random=std::move(owned.random);events.out.root=events.container(WOTR_LIST,rows);result.events=std::make_unique<Snapshot>(std::move(events.out));return result;
}
fm_Result apply_combat_onslaught(const Snapshot& source,const Snapshot& tables,const void* random_source,int64_t count){return co_action(source,tables,random_source,count,false);}
fm_Result apply_combat_onslaught_payment(const Snapshot& source,const Snapshot& tables,const void* random_source,int64_t index){return co_action(source,tables,random_source,index,true);}

void* wotr_search_overlay_sample(const void* state,const void* tables,int32_t root,void* rng){return checked<void*>([&]()->void*{require(rng,"Overlay RNG is null");return so_sample(snapshot(state),snapshot(tables),root,rng).release();},nullptr);}
void* wotr_search_overlay_import(const void* payload){return checked<void*>([&]()->void*{return so_import(snapshot(payload)).release();},nullptr);}
void* wotr_search_overlay_export(void* overlay){return checked<void*>([&]()->void*{return so_export(so_overlay(overlay)).release();},nullptr);}
void wotr_search_overlay_destroy(void* overlay){delete static_cast<so_Overlay*>(overlay);}
int wotr_search_overlay_require(void* overlay,void* rng,const char* card){return checked<int>([&](){require(rng&&card,"Overlay require arguments are null");return so_require(so_overlay(overlay),rng,card)?1:0;},-1);}
int wotr_search_overlay_patch(void* overlay,void* state,void* rng){return checked<int>([&](){require(rng,"Overlay RNG is null");so_patch(so_overlay(overlay),const_cast<Snapshot&>(snapshot(state)),rng);return 0;},-1);}
int wotr_search_overlay_recon(void* overlay,void* rng,int32_t deck,const void* zones){return checked<int>([&](){require(rng&&(deck==0||deck==1),"Overlay reconciliation arguments invalid");auto& z=snapshot(zones);auto xs=child_edges(z,z.root);require(xs.size()==3,"Overlay reconciliation requires three zones");so_recon(so_overlay(overlay),deck,so_cards(z,xs[0]),so_cards(z,xs[1]),so_cards(z,xs[2]),rng);return 0;},-1);}
void* wotr_search_overlay_root(const void* state,int32_t root){return checked<void*>([&]()->void*{return so_root_clone(snapshot(state),root).release();},nullptr);}
int wotr_search_overlay_prepare(void* overlay,void* state,void* rng,int32_t actor,const void* action,int32_t learned){return checked<int>([&](){require(rng&&(actor==0||actor==1)&&(learned==0||learned==1),"Overlay preparation arguments invalid");return so_prepare(so_overlay(overlay),const_cast<Snapshot&>(snapshot(state)),rng,actor,action?&snapshot(action):nullptr,learned!=0);},-1);}
void* wotr_search_overlay_mixture(const void* state,const void* tables){return checked<void*>([&]()->void*{return so_mixture_graph(snapshot(state),snapshot(tables)).release();},nullptr);}

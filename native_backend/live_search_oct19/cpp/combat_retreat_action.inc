uint64_t crp_army(Snapshot& s,std::string_view region){const auto key=sanitize_name(region);auto army=mu_army(s,key);if(army!=missing)return army;const auto board_region=ctx_get(s,obs_attr(s,obs_attr(s,s.root,"board"),"_regions"),key);require(board_region!=missing,"Retreat destination absent from board");const auto canonical=obs_attr(s,board_region,"key");const std::string destination=truth(s,canonical)?std::string(text(s,canonical)):key;army=mu_army(s,destination);if(army!=missing)return army;army=am_new_army(s,board_region);am_insert(s,destination,army);return army;}
void crp_relocate(Snapshot& s,const Snapshot& tables,std::string_view from,std::string_view to,int side){
    const std::string from_key=am_key(s,sanitize_name(from));const auto army=mu_army(s,sanitize_name(from));if(army==missing||!truth(s,obs_attr(s,army,"units")))return;const auto pc=obs_attr(s,s.root,"pending_combat",false);const auto original_units=child_edges(s,obs_attr(s,army,"units")),original_leaders=child_edges(s,obs_attr(s,army,"leaders"));
    if(!ctx_none(s,pc)&&cbb_side(s,pc,0)==side&&!ctx_none(s,field(s,pc,"attacker_rearguard",false))){
        const auto parts=ca_partition(s,army,from,side,pc);std::set<uint64_t> unit_ids(parts.units.begin(),parts.units.end()),leader_ids;std::vector<uint64_t> moved_leaders,units,leaders;for(auto leader:parts.leaders)if(!am_saruman(s,leader)){moved_leaders.push_back(leader);leader_ids.insert(leader);}for(auto unit:original_units)if(!unit_ids.count(unit))units.push_back(unit);for(auto leader:original_leaders)if(!leader_ids.count(leader))leaders.push_back(leader);am_assign_list(s,army,"units",units);am_assign_list(s,army,"leaders",leaders);const auto dest=crp_army(s,sanitize_name(to));am_extend(s,dest,"units",parts.units);am_extend(s,dest,"leaders",moved_leaders);if(units.empty()&&leaders.empty())am_erase(s,from_key);return;
    }
    // A retreat permits overstacking but is not a movement action: it never
    // activates nations. Co-located enemy Characters and Saruman stay behind.
    std::vector<uint64_t> moving,kept,moving_leaders,kept_leaders;
    for(auto unit:original_units)(ctx_unit_side(s,unit)==side?moving:kept).push_back(unit);
    if(moving.empty())return;
    for(auto leader:original_leaders)(cp_leader_side(s,leader)==side&&!am_saruman(s,leader)?moving_leaders:kept_leaders).push_back(leader);
    am_assign_list(s,army,"units",kept);am_assign_list(s,army,"leaders",kept_leaders);
    const auto dest=crp_army(s,sanitize_name(to));am_extend(s,dest,"units",moving);am_extend(s,dest,"leaders",moving_leaders);
    if(kept.empty()&&kept_leaders.empty())am_erase(s,from_key);
}

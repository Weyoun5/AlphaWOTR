// Remaining exact ordered combat phase menus, including optional advance splits.
int cpm_settlement(const Snapshot& s,const Snapshot& tables,std::string_view region){const auto key=sanitize_name(region);const auto meta=ctx_get(tables,field(tables,tables.root,"board_regions"),key);if(ctx_none(tables,meta)||(!truth(tables,field(tables,meta,"is_town",false))&&!truth(tables,field(tables,meta,"is_city",false))&&!truth(tables,field(tables,meta,"is_stronghold",false))))return -1;const auto nation=ctx_get(tables,field(tables,tables.root,"region_nations"),key);if(ctx_none(tables,nation))return -1;const int native=fp_nation(ctx_nation(tables,nation))?0:1;return contains_string(s,ctx_side_value(s,obs_attr(s,s.root,"enemy_controlled"),1-native),key)?1-native:native;}
void cpm_retreat(const Snapshot& s,const Snapshot& tables,uint64_t pc,bool defender,am_Builder& b,std::vector<uint64_t>& rows){
    const int side=cbb_side(s,pc,defender?1:0);const auto region=sanitize_name(text(s,field(s,pc,defender?"defender_region":"attacker_region")));const auto adj=ctx_get(s,obs_attr(s,obs_attr(s,s.root,"board"),"_adj"),region);if(ctx_none(s,adj))return;
    auto neighbors=child_edges(s,adj);std::sort(neighbors.begin(),neighbors.end(),[&](uint64_t a,uint64_t c){return text(s,a)<text(s,c);});
    for(auto entry:neighbors){const std::string name(text(s,entry)),key=sanitize_name(name);const auto army=mu_army(s,key);bool own=false,enemy=false;if(army!=missing)for(auto unit:child_edges(s,obs_attr(s,army,"units")))(ctx_unit_side(s,unit)==side?own:enemy)=true;const bool own_siege=contains_string(s,obs_attr(s,s.root,"besieged_strongholds",false),key)&&at_controller(s,tables,key)==1-side&&own;if((enemy||cpm_settlement(s,tables,name)==1-side)&&!own_siege)continue;rows.push_back(b.row(-1,"combat_retreat",{b.str("to_region"),b.str(name)}));}
}
std::unique_ptr<Snapshot> native_combat_phase_actions(const Snapshot& s,const Snapshot& tables,int side){
    require(side==0||side==1,"Combat phase owner must be FP or SH");const auto pc=obs_attr(s,s.root,"pending_combat"),phase=field(s,pc,"phase"),owner=field(s,pc,"deciding_side",false);am_Builder b;std::vector<uint64_t> rows;auto finish=[&](){b.out.root=b.container(WOTR_LIST,rows);return std::make_unique<Snapshot>(std::move(b.out));};if(!ctx_none(s,owner)&&!enum_is(s,owner,"game_state.Side",side==0?"FREE_PEOPLES":"SHADOW"))return finish();
    const std::string stage(text(s,phase));for(const char* guarded:{"attacker_combat_card","defender_combat_card","combat_round_result","attacker_continue","defender_retreat","defender_siege_choice","attacker_siege_decision"})if(stage==guarded){for(int role=0;role<2;++role)if(ca_units(s,text(s,field(s,pc,role==0?"attacker_region":"defender_region")),cbb_side(s,pc,role)).empty()){rows.push_back(b.row(-1,"combat_card_none",{b.str("side"),b.str(enum_is(s,owner,"game_state.Side","FREE_PEOPLES")?"fp":"sh")}));return finish();}break;}
    auto plain=[&](const char* action){rows.push_back(b.row(-1,action,{}));};
    if(stage=="attacker_continue"){plain("combat_continue");if(!truth(s,field(s,pc,"attacker_no_retreat",false)))plain("combat_cease");}
    else if(stage=="defender_siege_choice"){plain("retreat_into_siege");plain("combat_no_retreat");}
    else if(stage=="attacker_siege_decision")plain("siege_assault");
    else if(stage=="defender_retreat"){cpm_retreat(s,tables,pc,true,b,rows);if(!truth(s,field(s,pc,"is_siege",false))&&truth(s,field(s,pc,"stronghold_region",false))&&at_controller(s,tables,sanitize_name(text(s,field(s,pc,"defender_region"))))==cbb_side(s,pc,1))plain("retreat_into_siege");plain("combat_no_retreat");}
    else if(stage=="attacker_card_retreat"){cpm_retreat(s,tables,pc,false,b,rows);plain("combat_no_retreat");} // R2-SL-03: the decline row, as its defender_retreat twin (FLB-1 / 1.230); ai.py parity
    else if(stage=="combat_round_result"){bool elite=false;for(auto unit:ca_units(s,text(s,field(s,pc,"attacker_region")),cbb_side(s,pc,0)))elite|=enum_is(s,obs_attr(s,unit,"kind"),"game_state.UnitKind","ELITE");if(elite)plain("siege_press");plain("siege_no_press");}
    else if(stage=="siege_trim"){const auto units=ca_units(s,text(s,field(s,pc,"trim_region")),cbb_side(s,pc,1));int64_t elite=0;for(auto u:units)elite+=enum_is(s,obs_attr(s,u,"kind"),"game_state.UnitKind","ELITE");const auto excess=std::max<int64_t>(0,static_cast<int64_t>(units.size())-5);
        // R17-ENG-SIEGETRIM (ruling 1.181, ai siege_trim menu): the owner names WHOSE units return - one row per distinct
        // (nation, kind) set of the returned units ('unit_set', army_card_cargo freeze format; figure_sets order, Regular
        // sets outer, Elite sets inner, each set sorted), only when k can be filled more than one way; a single fill keeps
        // the plain k row.  Each row's set is a fresh value (Python builds one freeze() tuple per row: no shared nodes).
        std::vector<uint64_t> regs,elites;for(auto u:units)(enum_is(s,obs_attr(s,u,"kind"),"game_state.UnitKind","ELITE")?elites:regs).push_back(u);
        for(int64_t k=0;k<=std::min(excess,elite);++k){std::vector<am_FigureSet> mixes;for(const auto& rs:am_figure_sets(s,regs,excess-k,true))for(const auto& es:am_figure_sets(s,elites,k,true)){am_FigureSet mix=rs;mix.insert(mix.end(),es.begin(),es.end());std::sort(mix.begin(),mix.end());mixes.push_back(std::move(mix));}
            if(mixes.size()>1)for(const auto& mix:mixes)rows.push_back(b.row(-1,"siege_trim",{b.str("elites_back"),b.integer(k),b.str("excess"),b.integer(excess),b.str("unit_set"),am_set_value(b,mix)}));
            else rows.push_back(b.row(-1,"siege_trim",{b.str("elites_back"),b.integer(k),b.str("excess"),b.integer(excess)}));}}
    else if(stage=="victor_advance"){
        const std::string from(text(s,field(s,pc,"attacker_region"))),to(text(s,field(s,pc,"defender_region")));const int actor=cbb_side(s,pc,0);const auto army=mu_army(s,sanitize_name(from));if(army!=missing){const auto parts=ca_partition(s,army,from,actor,pc);int64_t regular=0,elite=0,nazgul=0,leaders=0;bool has_leader=false;for(auto u:parts.units)if(ctx_unit_side(s,u)==actor)(enum_is(s,obs_attr(s,u,"kind"),"game_state.UnitKind","REGULAR")?regular:elite)++;for(auto l:parts.leaders){const bool naz=object_type(s,l)=="game_state.Nazgul";nazgul+=actor==1&&naz;if(!naz&&!am_saruman(s,l)){has_leader=true;leaders+=am_leader_side(s,l)==actor;}}
            // E5-01 (D5 2026-10-22; ai victor_advance menu, RB31 "all or part", W4-Q12 each figure separately): the
            // victor names WHICH figures advance - 'unit_set' (the units' nation mix, only when the counts can be
            // filled more than one way) and 'leader_set' (the non-Nazgul leader set, only when the pool holds two or
            // more figure categories); army_card_cargo keys, figure_sets order, Python dict order.
            std::vector<uint64_t> regs,elites,lpool;for(auto u:parts.units)if(ctx_unit_side(s,u)==actor)(enum_is(s,obs_attr(s,u,"kind"),"game_state.UnitKind","REGULAR")?regs:elites).push_back(u);
            for(auto l:parts.leaders)if(object_type(s,l)!="game_state.Nazgul"&&!am_saruman(s,l)&&am_leader_side(s,l)==actor)lpool.push_back(l);
            std::vector<std::vector<am_FigureSet>> lsets;if(leaders>1&&am_figure_categories(s,lpool,false)>1){lsets.resize(static_cast<size_t>(leaders));for(int64_t k=1;k<leaders;++k)lsets[static_cast<size_t>(k)]=am_figure_sets(s,lpool,k,false);}
            // C01 (round 18; ruling 1.128-b / W4-035, W4-Q12; ai victor_advance _vmust9 / _vstay9 / _vlmust9): only plain Leaders
            // must follow a FULL advance - Companions and the named Minions may stay behind on their own (Nazgul already do, on
            // n_nazgul), as the army_move full vacate: take_leaders=false and the n_leaders rows are offered on a full advance too,
            // a count row covering every plain Leader (l >= must), a leader_set carrying all of them (covers_must).
            int64_t must=0;std::map<am_FigureKey,int64_t> lmust;for(auto l:lpool)if(am_plain(s,l)){++must;++lmust[am_figure_key(s,l,false)];}
            const bool stay=must==0&&leaders>0;
            auto covers_must=[&](const am_FigureSet& set){for(const auto& entry:lmust)if(am_set_count(set,entry.first)!=entry.second)return false;return true;};
            // R6-NATIVE-LEADER-SET-INTERN (DEP-1 F2): Python shares its figure-set tuples here - one _ls9 (_vlsets9, built once per menu)
            // R6-NATIVE-LEADER-SET-INTERN: for every row naming that set; one _uset9 per (n_regular, n_elite, mix) for all of its
            // R6-NATIVE-LEADER-SET-INTERN: n_nazgul x take_leaders and n_leaders rows; and a mix's Regular rows ARE the _rsets9 tuples
            // R6-NATIVE-LEADER-SET-INTERN: (built once per n_regular, so shared by every n_elite), its Elite rows fresh per mix.
            std::map<const am_FigureSet*,uint64_t> lnodes;   // R6-NATIVE-LEADER-SET-INTERN: one leader_set node per lsets entry
            auto lset_node=[&](const am_FigureSet* set)->uint64_t{auto found=lnodes.find(set);if(found==lnodes.end())found=lnodes.emplace(set,am_set_value(b,*set)).first;return found->second;};   // R6-NATIVE-LEADER-SET-INTERN
            auto row_node=[&](const std::pair<am_FigureKey,int64_t>& entry)->uint64_t{return b.container(WOTR_TUPLE,{b.str(std::get<0>(entry.first)),b.str(std::get<1>(entry.first)),b.str(std::get<2>(entry.first)),b.integer(entry.second)});};   // R6-NATIVE-LEADER-SET-INTERN: am_set_value's row
            for(int64_t r=0;r<=regular;++r){const auto rsets=am_figure_sets(s,regs,r,true);std::vector<std::map<am_FigureKey,uint64_t>> rnodes(rsets.size());for(int64_t e=0;e<=elite;++e){if(r+e==0)continue;const bool full=r+e==regular+elite;   // R6-NATIVE-LEADER-SET-INTERN: rnodes = each rsets entry's Regular row nodes
                std::vector<am_FigureSet> usets;std::vector<size_t> ufrom;for(size_t i=0;i<rsets.size();++i)for(const auto& es:am_figure_sets(s,elites,e,true)){am_FigureSet mix=rsets[i];mix.insert(mix.end(),es.begin(),es.end());std::sort(mix.begin(),mix.end());usets.push_back(std::move(mix));ufrom.push_back(i);}   // R6-NATIVE-LEADER-SET-INTERN: ufrom = each mix's rsets entry
                std::map<size_t,uint64_t> unodes;auto uset_node=[&](size_t m)->uint64_t{auto found=unodes.find(m);if(found!=unodes.end())return found->second;const auto& rs=rsets[ufrom[m]];auto& shared=rnodes[ufrom[m]];std::vector<uint64_t> items;for(const auto& entry:usets[m]){if(am_set_count(rs,entry.first)){auto row=shared.find(entry.first);if(row==shared.end())row=shared.emplace(entry.first,row_node(entry)).first;items.push_back(row->second);}else items.push_back(row_node(entry));}const auto node=b.container(WOTR_TUPLE,items);unodes.emplace(m,node);return node;};   // R6-NATIVE-LEADER-SET-INTERN
                const size_t mixes=usets.size()>1?usets.size():1;
                for(size_t m=0;m<mixes;++m){const am_FigureSet* uset=usets.size()>1?&usets[m]:nullptr;
                    for(int64_t n=0;n<=nazgul;++n){const std::vector<bool> choices=has_leader?(full&&!stay?std::vector<bool>{true}:std::vector<bool>{true,false}):std::vector<bool>{full};for(bool take:choices){std::vector<uint64_t> p={b.str("from"),b.str(from),b.str("to"),b.str(to),b.str("n_regular"),b.integer(r),b.str("n_elite"),b.integer(e),b.str("take_leaders"),rr_scalar(b.out,WOTR_BOOL,take),b.str("side"),b.str(actor==0?"fp":"sh")};if(uset){p.push_back(b.str("unit_set"));p.push_back(uset_node(m));}if(nazgul){p.push_back(b.str("n_nazgul"));p.push_back(b.integer(n));}rows.push_back(b.row(-1,"victor_advance",p));}   // R6-NATIVE-LEADER-SET-INTERN: uset_node
                        if(has_leader&&leaders>1)for(int64_t l=1;l<leaders;++l){if(full&&lsets.empty()&&l<must)continue;const size_t sets=lsets.empty()?1:lsets[static_cast<size_t>(l)].size();for(size_t q=0;q<sets;++q){const am_FigureSet* lset=lsets.empty()?nullptr:&lsets[static_cast<size_t>(l)][q];if(full&&lset&&!covers_must(*lset))continue;std::vector<uint64_t> p={b.str("from"),b.str(from),b.str("to"),b.str(to),b.str("n_regular"),b.integer(r),b.str("n_elite"),b.integer(e),b.str("take_leaders"),rr_scalar(b.out,WOTR_BOOL,1),b.str("n_leaders"),b.integer(l)};if(lset){p.push_back(b.str("leader_set"));p.push_back(lset_node(lset));}p.push_back(b.str("side"));p.push_back(b.str(actor==0?"fp":"sh"));if(uset){p.push_back(b.str("unit_set"));p.push_back(uset_node(m));}if(nazgul){p.push_back(b.str("n_nazgul"));p.push_back(b.integer(n));}rows.push_back(b.row(-1,"victor_advance",p));}}}}}}   // R6-NATIVE-LEADER-SET-INTERN: lset_node / uset_node
        }plain("victor_stay");
    }else throw std::invalid_argument("Unsupported combat phase menu");
    // R2-SL-03: never a battle-dissolving 'pass' fallback (ai._get_pending_combat_actions raises the same way)
    require(!rows.empty(),"required combat decision has no legal row");return finish();
}
